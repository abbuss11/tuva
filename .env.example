# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publique de l'app (utilisée pour générer les QR codes de vérification)
NEXT_PUBLIC_SITE_URL=https://tuva-tau.vercel.app

# Notifications facultatives (Resend)
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=TUVA <attestations@votre-domaine.com>

# Notifications facultatives (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+00000000000